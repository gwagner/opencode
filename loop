#!/bin/sh
set -eu

usage() {
  cat <<'USAGE'
Usage:
  ./loop [--test|--dry-run] <project> <agent> [git-repo]

Todo mode reads the next unchecked markdown checkbox from git-repo/todo.md
(default repo: /code), runs OpenCode until that task is done, marks it done,
then continues until all tasks are complete.

Test mode prints the detected tasks, loop commands, and prompts without
running OpenCode, committing, or editing the todo file.

Environment:
  MAX_LOOPS  Maximum OpenCode runs per task. Default: 5.
USAGE
}

TEST_MODE=false
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
RUNNER="$SCRIPT_DIR/run"
case "${1:-}" in
  --test|--dry-run)
    TEST_MODE=true
    shift
    ;;
esac

if [ "$#" -lt 2 ]; then
  usage
  exit 1
fi

PROJECT="$1"
AGENT="$2"
REPO_PATH="${3:-/code}"
TASK_SOURCE="$REPO_PATH/todo.md"
TASK_REPO_FILE="todo.md"
MAX_LOOPS="${MAX_LOOPS:-5}"
DONE_TOKEN="<task>DONE</task>"
BLOCKED_TOKEN="<task>BLOCKED</task>"
TEST_PREFLIGHT_ACTION="not checked"

if { [ -t 1 ] || [ "${FORCE_COLOR:-}" = "1" ]; } && [ -z "${NO_COLOR:-}" ]; then
  BOLD='\033[1m'
  DIM='\033[2m'
  BLUE='\033[34m'
  CYAN='\033[36m'
  GREEN='\033[32m'
  MAGENTA='\033[35m'
  YELLOW='\033[33m'
  RESET='\033[0m'
else
  BOLD=''
  DIM=''
  BLUE=''
  CYAN=''
  GREEN=''
  MAGENTA=''
  YELLOW=''
  RESET=''
fi

hr() {
  printf '%b%s%b\n' "$DIM" '────────────────────────────────────────────────────────────' "$RESET"
}

test_header() {
  title="$1"
  printf '\n%b%s%b\n' "$BOLD$MAGENTA" "$title" "$RESET"
  hr
}

test_field() {
  label="$1"
  value="$2"
  printf '%b%-20s%b %s\n' "$CYAN" "$label:" "$RESET" "$value"
}

test_block() {
  label="$1"
  body="$2"
  printf '%b%s%b\n' "$YELLOW" "$label" "$RESET"
  printf '%s\n' "$body" | while IFS= read -r block_line; do
    printf '%b│%b %s\n' "$DIM" "$RESET" "$block_line"
  done
}

is_todo_file() {
  [ -f "$TASK_SOURCE" ]
}

count_unchecked_tasks() {
  if [ -f "$TASK_SOURCE" ]; then
    grep -cE '^[[:space:]]*[-*] \[ \] ' "$TASK_SOURCE" || true
  else
    printf '0\n'
  fi
}

next_task_line() {
  grep -nE '^[[:space:]]*[-*] \[ \] ' "$TASK_SOURCE" | head -n 1 | cut -d: -f1 || true
}

all_task_lines() {
  grep -nE '^[[:space:]]*[-*] \[ \] ' "$TASK_SOURCE" | cut -d: -f1 || true
}

task_text() {
  line="$1"
  sed -n "${line}p" "$TASK_SOURCE" | sed -E 's/^[[:space:]]*[-*] \[ \] //'
}

todo_prompt_path() {
  printf '%s\n' "/code/todo.md"
}

mark_done() {
  line="$1"
  tmp_file="${TASK_SOURCE}.tmp.$$"
  sed "${line}s/^\([[:space:]]*[-*] \)\[ \]/\1[x]/" "$TASK_SOURCE" > "$tmp_file"
  mv "$tmp_file" "$TASK_SOURCE"
}

build_prompt() {
  task="$1"
  todo_path="$(todo_prompt_path)"
  cat <<PROMPT
TODO_LOOP_MODE=true
TODO_FILE=/code/todo.md

Read $todo_path. Complete exactly this unchecked task and no other todo task:

$task

If you discover additional required follow-up work while doing this task, load and use the todo-upkeep skill because TODO_LOOP_MODE=true. Append new unchecked tasks to /code/todo.md. Do not perform those newly added tasks in this iteration.

Before replying $DONE_TOKEN, all code changes for this task must be validated and committed. Load git-auto-commit because this prompt explicitly requests a commit. Commit only this task's required files; do not commit unrelated files or later todo work. If no commit is needed, explain why before the final token.

If this task is not done but should continue in another loop iteration, leave a concise handoff file at /project/handoff.md describing current state, completed work, next steps, blockers, and validation status. Then reply without $DONE_TOKEN or $BLOCKED_TOKEN so the loop can continue.

If blocked and replying $BLOCKED_TOKEN, do not commit partial work. The loop runner will revert the task worktree to clean.

When the task is fully complete and validated, reply strictly with:
$DONE_TOKEN

If blocked, reply strictly with:
$BLOCKED_TOKEN followed by a short reason.
PROMPT
}

run_opencode() {
  prompt="$1"
  "$RUNNER" "$PROJECT" run "$prompt" --agent "$AGENT"
}

git_available() {
  command -v git >/dev/null 2>&1
}

inside_git_repo() {
  git_available && git -C "$REPO_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

has_uncommitted_tracked_changes() {
  ! git -C "$REPO_PATH" diff --quiet --ignore-submodules -- || ! git -C "$REPO_PATH" diff --cached --quiet --ignore-submodules --
}

has_worktree_changes() {
  [ -n "$(git -C "$REPO_PATH" status --porcelain)" ]
}

ensure_clean_worktree() {
  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if ! has_worktree_changes; then
    return 0
  fi

  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · clean-worktree preflight"
    test_field "Git repo" "$REPO_PATH"
    printf '%b✓ Would require a clean worktree before task execution so BLOCKED can safely revert task-owned changes.%b\n' "$GREEN" "$RESET"
    return 0
  fi

  printf '%bTarget repo still has uncommitted or untracked changes after preflight; refusing to start loop.%b\n' "$YELLOW" "$RESET"
  printf 'Commit, stash, or remove these changes first so BLOCKED can revert to a clean tree safely.\n'
  git -C "$REPO_PATH" status --short
  exit 4
}

revert_to_clean_worktree() {
  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · blocked cleanup"
    test_field "Git repo" "$REPO_PATH"
    printf '%b✓ Would run git reset --hard and git clean -fd after %s.%b\n' "$GREEN" "$BLOCKED_TOKEN" "$RESET"
    return 0
  fi

  if has_worktree_changes; then
    printf '%bTask blocked; reverting task changes to a clean worktree.%b\n' "$YELLOW" "$RESET"
    git -C "$REPO_PATH" reset --hard
    git -C "$REPO_PATH" clean -fd
  fi
}

stash_between_todos() {
  task_line="$1"

  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if ! has_worktree_changes; then
    return 0
  fi

  stash_message="todo line $task_line completed before next todo"

  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · between-todo stash"
    test_field "Git repo" "$REPO_PATH"
    test_field "Stash message" "$stash_message"
    printf '%b✓ Would stash dirty worktree with git stash push -u -m before moving to the next todo.%b\n' "$GREEN" "$RESET"
    return 0
  fi

  printf '%bDirty worktree between todos; stashing before moving to next todo.%b\n' "$YELLOW" "$RESET"
  git -C "$REPO_PATH" stash push -u -m "$stash_message"

  if has_worktree_changes; then
    printf '%bWorktree remains dirty after stash; cannot continue safely.%b\n' "$YELLOW" "$RESET"
    git -C "$REPO_PATH" status --short
    exit 7
  fi
}

clear_loop_handoff() {
  [ -f /project/handoff.md ] && rm -f /project/handoff.md
}

warn_dirty_worktree() {
  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if has_worktree_changes; then
    printf '\n%b%s%b\n' "$BOLD$YELLOW" '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!' "$RESET"
    printf '%bWARNING: loop finished with a dirty working tree.%b\n' "$BOLD$YELLOW" "$RESET"
    printf '%bReview, commit, stash, or clean these changes before continuing.%b\n' "$YELLOW" "$RESET"
    git -C "$REPO_PATH" status --short
    printf '%b%s%b\n\n' "$BOLD$YELLOW" '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!' "$RESET"
  fi
}

build_commit_prompt() {
  cat <<PROMPT
Inspect /code uncommitted changes. /code is the OpenCode container mount for $REPO_PATH. Include untracked files when they are required for the completed task.

Determine a concise, accurate commit message for the completed task work, then commit that work before the loop marks the todo item done.

Required process:
1. Inspect git status, tracked diffs, staged diffs, and recent commit style.
2. Load git-auto-commit because this prompt explicitly requests a commit.
3. Stage only files required for the completed task, including required untracked files. Do not stage unrelated files.
4. Commit with the chosen message.
5. Report the commit hash and message, or explain why no commit was created.
PROMPT
}

test_summary() {
  task_count="$(count_unchecked_tasks)"
  test_header "TEST MODE · summary"
  test_field "Git repo" "$REPO_PATH"
  test_field "Todo file" "$TASK_SOURCE"
  test_field "Commit prompt" "$TEST_PREFLIGHT_ACTION"
  test_field "Todo tasks" "would run $task_count unchecked task(s), up to $MAX_LOOPS OpenCode run(s) each"
  test_field "DONE path" "prompt requires commit first; script would mark todo done and commit todo.md progress"
  test_field "BLOCKED path" "would leave todo unchecked, revert task worktree, and exit 2"
  test_field "Continue path" "prompt requires agent-authored /project/handoff.md before next same-task iteration"
  test_field "Between todos" "would stash dirty worktree before moving to next todo, with todo line in stash message"
  test_field "Final state" "would warn loudly if all todos finish with a dirty worktree"
  test_field "OpenCode runs" "none executed in test mode"
  printf '%b✓ TEST MODE: no OpenCode runs executed, no commits made, and no todo file edits made.%b\n' "$GREEN" "$RESET"
}

prompt_commit_tracked_changes() {
  if ! git_available; then
    TEST_PREFLIGHT_ACTION="would skip commit prompt: git unavailable"
    return 0
  fi

  if ! inside_git_repo; then
    TEST_PREFLIGHT_ACTION="would skip commit prompt: target is not a git repo"
    return 0
  fi

  if ! has_uncommitted_tracked_changes; then
    TEST_PREFLIGHT_ACTION="would not run commit session: no tracked uncommitted changes"
    return 0
  fi

  commit_prompt="$(build_commit_prompt)"
  TEST_PREFLIGHT_ACTION="would ask to open code-implementor commit session"

  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · tracked-change commit prompt"
    test_field "Git repo" "$REPO_PATH"
    test_field "Project" "$PROJECT"
    test_field "Agent" "code-implementor"
    test_block "Command" "$RUNNER \"$PROJECT\" run \"<prompt>\" --agent \"code-implementor\""
    test_block "Prompt" "$commit_prompt"
    printf '%b✓ Would ask before opening this commit session.%b\n' "$GREEN" "$RESET"
    return 0
  fi

  printf '%bTracked uncommitted changes detected.%b\n' "$YELLOW" "$RESET"
  if [ ! -t 0 ]; then
    printf 'No interactive stdin available; skipping commit prompt.\n'
    return 0
  fi

  printf 'Open an opencode commit-message/commit session with code-implementor? [y/N] '
  read answer
  case "$answer" in
    y|Y|yes|YES)
      "$RUNNER" "$PROJECT" run "$commit_prompt" --agent "code-implementor"
      if has_uncommitted_tracked_changes; then
        printf '%bTracked changes remain after commit session.%b\n' "$YELLOW" "$RESET"
      fi
      ;;
    *)
      printf 'Skipping commit prompt. Continuing loop.\n'
      ;;
  esac
}

auto_commit_tracked_changes() {
  if ! git_available; then
    return 0
  fi

  if ! inside_git_repo; then
    return 0
  fi

  if ! has_worktree_changes; then
    return 0
  fi

  commit_prompt="$(build_commit_prompt)"

  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · worktree auto commit session"
    test_field "Git repo" "$REPO_PATH"
    test_field "Project" "$PROJECT"
    test_field "Agent" "code-implementor"
    test_block "Command" "$RUNNER \"$PROJECT\" run \"<prompt>\" --agent \"code-implementor\""
    test_block "Prompt" "$commit_prompt"
    printf '%b✓ Would automatically open this commit session without asking.%b\n' "$GREEN" "$RESET"
    return 0
  fi

  printf '%bWorktree changes detected; opening automatic commit session.%b\n' "$YELLOW" "$RESET"
  "$RUNNER" "$PROJECT" run "$commit_prompt" --agent "code-implementor"
  if has_worktree_changes; then
    printf '%bWorktree changes remain after automatic commit session.%b\n' "$YELLOW" "$RESET"
  fi
}

commit_todo_progress() {
  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if ! git -C "$REPO_PATH" diff --quiet -- "$TASK_REPO_FILE"; then
    git -C "$REPO_PATH" add -- "$TASK_REPO_FILE"
    git -C "$REPO_PATH" commit -m "Mark completed todo task"
  fi
}

run_todo_loop() {
  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · todo loop"
    test_field "Project" "$PROJECT"
    test_field "Agent" "$AGENT"
    test_field "Git repo" "$REPO_PATH"
    test_field "Todo file" "$TASK_SOURCE"
    test_field "Max loops/task" "$MAX_LOOPS"
    hr
    all_task_lines | while IFS= read -r line; do
      task="$(task_text "$line")"
      prompt="$(build_prompt "$task")"
      next_after_task="$(awk -v current="$line" '/^[[:space:]]*[-*] \[ \] / && NR > current { print NR; exit }' "$TASK_SOURCE")"
      printf '\n%bTask line %s%b\n' "$BOLD$BLUE" "$line" "$RESET"
      test_field "Task" "$task"
      test_block "Command" "$RUNNER \"$PROJECT\" run \"<prompt>\" --agent \"$AGENT\""
      test_block "Prompt" "$prompt"
      test_block "DONE path" "Agent prompt requires validation and git-auto-commit before $DONE_TOKEN.
Script would clear /project/handoff.md, open a fallback commit session if worktree remains dirty, mark line $line complete, and commit todo.md progress."
      test_block "BLOCKED path" "Script would clear /project/handoff.md, leave line $line unchecked, run git reset --hard plus git clean -fd, and exit 2."
      test_block "Continue path" "Agent prompt requires writing /project/handoff.md before omitting DONE/BLOCKED.
Script would not write a handoff; it would run the same todo again until MAX_LOOPS=$MAX_LOOPS."
      if [ -n "$next_after_task" ]; then
        test_block "Between-todo path" "If the worktree is dirty after completing line $line, script would run:
git stash push -u -m \"todo line $line completed before next todo\"
Then it would move to todo line $next_after_task."
      else
        test_block "Final-todo path" "No later unchecked todo exists. Script would not stash between todos; at final completion it would print a prominent dirty-worktree warning if needed."
      fi
      auto_commit_tracked_changes
      hr
    done
    test_summary
    return 0
  fi

  while true; do
    line="$(next_task_line || true)"
    if [ -z "$line" ]; then
      echo "All todo tasks completed."
      warn_dirty_worktree
      return 0
    fi

    task="$(task_text "$line")"
    prompt="$(build_prompt "$task")"

    echo "Next task on line $line: $task"

    completed=false
    for i in $(seq 1 "$MAX_LOOPS"); do
      echo "Starting task loop #$i..."
      output=$(run_opencode "$prompt")
      echo "$output"

      case "$output" in
      *"$DONE_TOKEN"*)
        clear_loop_handoff
        auto_commit_tracked_changes
        mark_done "$line"
        echo "Marked task complete."
        commit_todo_progress
        completed=true
        break
        ;;
      esac

      case "$output" in
      *"$BLOCKED_TOKEN"*)
        clear_loop_handoff
        echo "Task blocked. Leaving todo unchecked."
        revert_to_clean_worktree
        exit 2
        ;;
      esac

      if [ "$i" -lt "$MAX_LOOPS" ]; then
        echo "Task continuing. Expecting agent-authored /project/handoff.md for next iteration."
      fi
    done

    if [ "$completed" != true ]; then
      clear_loop_handoff
      echo "Max loops reached for task. Leaving todo unchecked."
      exit 3
    fi

    if [ -n "$(next_task_line || true)" ]; then
      stash_between_todos "$line"
    fi
  done
}

prompt_commit_tracked_changes
ensure_clean_worktree

if is_todo_file; then
  run_todo_loop
else
  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · todo loop"
    test_field "Git repo" "$REPO_PATH"
    test_field "Todo file" "$TASK_SOURCE"
    test_field "Todo status" "todo.md not found; no todo tasks would run"
    test_summary
    exit 0
  fi
  echo "No todo.md found at $TASK_SOURCE. Nothing to run."
fi
