#!/bin/sh
set -eu

usage() {
  cat <<'USAGE'
Usage:
  ./loop [--test|--dry-run] <project> <agent> [git-repo]

Todo mode reads the next unchecked markdown checkbox from git-repo/todo.md
(default repo: /code), runs OpenCode until that task is done or blocked,
records the outcome, then continues until no todo tasks remain.

Test mode prints the detected tasks, loop commands, and prompts without
running OpenCode, committing, or editing the todo file.

Environment:
  MAX_LOOPS  Maximum OpenCode runs per task. Default: 10.
USAGE
}

TEST_MODE=false
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
RUNNER="$SCRIPT_DIR/run"
case "${1:-}" in
  --test|--dry-run)
    TEST_MODE=true
    shift
    ;;
esac

if [ "$#" -lt 2 ]; then
  usage
  exit 1
fi

PROJECT="$1"
AGENT="$2"
REPO_PATH="${3:-/code}"
TASK_SOURCE="$REPO_PATH/todo.md"
TASK_REPO_FILE="todo.md"
BLOCKED_TASK_SOURCE="$REPO_PATH/blocked-todos.md"
MAX_LOOPS="${MAX_LOOPS:-10}"
CONTINUE_TOKEN="<task>CONTINUE</task>"
DONE_TOKEN="<task>DONE</task>"
BLOCKED_TOKEN="<task>BLOCKED</task>"
STOP_REQUESTED=false

if { [ -t 1 ] || [ "${FORCE_COLOR:-}" = "1" ]; } && [ -z "${NO_COLOR:-}" ]; then
  BOLD='\033[1m'
  DIM='\033[2m'
  BLUE='\033[34m'
  CYAN='\033[36m'
  GREEN='\033[32m'
  MAGENTA='\033[35m'
  YELLOW='\033[33m'
  RESET='\033[0m'
else
  BOLD=''
  DIM=''
  BLUE=''
  CYAN=''
  GREEN=''
  MAGENTA=''
  YELLOW=''
  RESET=''
fi

hr() {
  printf '%b%s%b\n' "$DIM" '────────────────────────────────────────────────────────────' "$RESET"
}

test_header() {
  title="$1"
  printf '\n%b%s%b\n' "$BOLD$MAGENTA" "$title" "$RESET"
  hr
}

test_field() {
  label="$1"
  value="$2"
  printf '%b%-20s%b %s\n' "$CYAN" "$label:" "$RESET" "$value"
}

test_block() {
  label="$1"
  body="$2"
  printf '%b%s%b\n' "$YELLOW" "$label" "$RESET"
  printf '%s\n' "$body" | while IFS= read -r block_line; do
    printf '%b│%b %s\n' "$DIM" "$RESET" "$block_line"
  done
}

is_todo_file() {
  [ -f "$TASK_SOURCE" ]
}

count_unchecked_tasks() {
  if [ -f "$TASK_SOURCE" ]; then
    grep -cE '^[[:space:]]*[-*] \[ \] ' "$TASK_SOURCE" || true
  else
    printf '0\n'
  fi
}

count_checked_tasks() {
  if [ -f "$TASK_SOURCE" ]; then
    grep -cE '^[[:space:]]*[-*] \[x\] ' "$TASK_SOURCE" || true
  else
    printf '0\n'
  fi
}

count_all_tasks() {
  if [ -f "$TASK_SOURCE" ]; then
    grep -cE '^[[:space:]]*[-*] \[[ x]\] ' "$TASK_SOURCE" || true
  else
    printf '0\n'
  fi
}

next_task_line() {
  grep -nE '^[[:space:]]*[-*] \[ \] ' "$TASK_SOURCE" | head -n 1 | cut -d: -f1 || true
}

all_task_lines() {
  grep -nE '^[[:space:]]*[-*] \[ \] ' "$TASK_SOURCE" | cut -d: -f1 || true
}

task_text() {
  line="$1"
  sed -n "${line}p" "$TASK_SOURCE" | sed -E 's/^[[:space:]]*[-*] \[ \] //'
}

task_block() {
  line="$1"
  awk -v current="$line" '
    NR == current { print; in_block = 1; next }
    in_block {
      if ($0 ~ /^[[:space:]]+[^[:space:]]/) {
        print
        next
      }
      exit
    }
  ' "$TASK_SOURCE"
}

task_branch() {
  block="$1"
  branch_lines="$(printf '%s\n' "$block" | sed -n 's/^[[:space:]]*-[[:space:]]*Branch:[[:space:]]*//p')"
  branch_count="$(printf '%s\n' "$branch_lines" | awk 'NF { count++ } END { print count + 0 }')"
  all_branch_count="$(printf '%s\n' "$block" | grep -cE '^[[:space:]]*-[[:space:]]*Branch:' || true)"

  if [ "$all_branch_count" -ne 1 ] || [ "$branch_count" -ne 1 ]; then
    printf '%bTask must contain exactly one nonempty Branch metadata value.%b\n' "$YELLOW" "$RESET" >&2
    return 1
  fi

  branch="$(printf '%s\n' "$branch_lines" | awk 'NF { print; exit }')"
  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    printf '%bInvalid Git branch name in task metadata: %s%b\n' "$YELLOW" "$branch" "$RESET" >&2
    return 1
  fi
  printf '%s\n' "$branch"
}

loop_status() {
  phase="$1"
  current_line="${2:-}"
  current_task="${3:-}"
  run_number="${4:-}"
  completed_count="$(count_checked_tasks)"
  remaining_count="$(count_unchecked_tasks)"
  total_count="$(count_all_tasks)"

  printf '\n%b%s%b %b%s%b\n' "$BOLD$MAGENTA" 'Loop status' "$RESET" "$YELLOW" "$phase" "$RESET"
  hr
  test_field 'Project' "$PROJECT"
  test_field 'Agent' "$AGENT"
  test_field 'Git repo' "$REPO_PATH"
  test_field 'Todo file' "$TASK_SOURCE"
  test_field 'Progress' "$completed_count completed / $remaining_count remaining / $total_count total"
  test_field 'Max loops/task' "$MAX_LOOPS"
  if [ -n "$current_line" ]; then
    test_field 'Current line' "$current_line"
  fi
  if [ -n "$run_number" ]; then
    test_field 'Task loop' "$run_number of $MAX_LOOPS"
  fi
  if [ -n "$current_task" ]; then
    test_block 'Current task' "$current_task"
  fi
}

loop_timestamp() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

loop_epoch() {
  date '+%s'
}

print_loop_duration() {
  loop_start_epoch="$1"
  loop_end_epoch="$(loop_epoch)"
  loop_duration_seconds=$((loop_end_epoch - loop_start_epoch))
  if [ "$loop_duration_seconds" -lt 0 ]; then
    loop_duration_seconds=0
  fi
  test_field 'Loop duration' "${loop_duration_seconds}s"
}

todo_prompt_path() {
  printf '%s\n' "/code/todo.md"
}

mark_done() {
  line="$1"
  tmp_file="${TASK_SOURCE}.tmp.$$"
  sed "${line}s/^\([[:space:]]*[-*] \)\[ \]/\1[x]/" "$TASK_SOURCE" > "$tmp_file"
  mv "$tmp_file" "$TASK_SOURCE"
}

blocked_reason() {
  output_file="$1"
  tr -d '\000' < "$output_file" | awk -v token="$BLOCKED_TOKEN" '
    index($0, token) {
      reason = substr($0, index($0, token) + length(token))
      sub(/^[[:space:]]+/, "", reason)
      sub(/[[:space:]]+$/, "", reason)
      print reason
      exit
    }
  '
}

move_task_to_blocked() {
  line="$1"
  block="$2"
  handoff_context="$3"
  reason="$4"
  todo_tmp="${TASK_SOURCE}.tmp.$$"
  blocked_tmp="${BLOCKED_TASK_SOURCE}.tmp.$$"

  if [ -f "$BLOCKED_TASK_SOURCE" ]; then
    cp "$BLOCKED_TASK_SOURCE" "$blocked_tmp"
  else
    : > "$blocked_tmp"
  fi

  if [ -s "$blocked_tmp" ]; then
    printf '\n' >> "$blocked_tmp"
  fi
  {
    printf '%s\n' "$block" | sed '/^[[:space:]]*-[[:space:]]*Handoff:/d'
    printf '  - Blocked by: %s\n' "$reason"
    printf '  - Required to unblock: |-\n'
    printf '%s\n' "$handoff_context" | sed 's/^/      /'
  } >> "$blocked_tmp"

  awk -v current="$line" '
    NR < current { print; next }
    NR == current { removing = 1; next }
    removing && $0 ~ /^[[:space:]]+[^[:space:]]/ { next }
    { removing = 0; print }
  ' "$TASK_SOURCE" > "$todo_tmp"

  mv "$blocked_tmp" "$BLOCKED_TASK_SOURCE"
  mv "$todo_tmp" "$TASK_SOURCE"
}

handoff_prompt_block() {
  if [ ! -f /project/handoff.md ]; then
    return 0
  fi

  cat <<'PROMPT'

Continuation context from /project/handoff.md for this same task:

PROMPT
  cat /project/handoff.md
}

build_prompt() {
  task="$1"
  attempt="$2"
  todo_path="$(todo_prompt_path)"
  cat <<PROMPT
# Metadata: 

TODO_LOOP_MODE=true
Loop attempt: $attempt of $MAX_LOOPS.

# Task:

$task

# Handoff:

Below is a handoff from a previous itteration of working on this task.  It may be blank depending on the state of processing:

PROMPT
  handoff_prompt_block
  cat <<PROMPT

# Instructions:

Do NOT read /code/todo.md.  Focus only on the taks that you have been given.  Utilize /project/requirements/ and /project/specification/ as needed to complete the provided task.

For code inspection, introspection, and reflection, load the graphify skill only when /code/graphify-out/graph.json exists. Otherwise use normal repository inspection.

Do one safe, meaningful increment of work toward finishing this task. Do not force full completion in one pass.

Before replying, run the relevant validation for the changes made in this iteration. Do not leave the repository in a knowingly failing state between iterations.

Once the todo is completed and validation has been run, use what you have learned to perform a curiosity pass across the todo, requirements, code spec, and code base.  This pass is used to survey the broader codebase for other hot paths that may not have been considered in the original todo.

If you discover additional required follow-up work while doing this task, load and use the todo-upkeep skill because TODO_LOOP_MODE=true. Append new unchecked tasks to /code/todo.md. Do not perform those newly added tasks in this iteration.

Before replying $DONE_TOKEN, all code changes for this task must be validated and committed. Load git-auto-commit because this prompt explicitly requests a commit. Commit only this task's required files; do not commit unrelated files or later todo work. If no commit is needed, explain why before the final token.

If this task is not fully complete but can continue in another iteration, you must write to /project/handoff.md with concise continuation context: current state, completed work, remaining work, blockers, and validation status. Then reply strictly with:
$CONTINUE_TOKEN

Use $CONTINUE_TOKEN only when more task work remains and the repository is left in a validated passing state for the relevant checks run in this iteration.

If blocked, write /project/handoff.md with the specific actions, decisions, information, or authoritative updates required to unblock the task, then reply $BLOCKED_TOKEN followed by a short reason describing what blocks progress. Do not commit partial work yourself. The loop runner records these as Required to unblock and Blocked by metadata in blocked-todos.md, removes implementation routing metadata, commits partial work to the task branch, returns to main without merging that branch, and continues with the next todo.

When the task is fully complete, validated, and there is no leftover work to complete reply strictly with:
$DONE_TOKEN

If blocked, reply strictly with:
$BLOCKED_TOKEN followed by a short reason.

Do not reply without one of these task tokens.
PROMPT
}

build_handoff_recovery_prompt() {
  task="$1"
  attempt="$2"
  cat <<PROMPT
TODO_LOOP_MODE=true
Loop attempt: $attempt of $MAX_LOOPS.

The previous run requested $CONTINUE_TOKEN but did not create /project/handoff.md.

Inspect what code changes are currently staged in /code and determine the next steps based on this todo:

$task

Do not continue implementation or commit changes during this recovery run. Preserve the current branch and worktree, then write /project/handoff.md for the next loop iteration with concise continuation context: current state, staged changes, remaining steps, blockers, and validation status.
PROMPT
}

run_opencode() {
  prompt="$1"
  "$RUNNER" "$PROJECT" run "$prompt" --agent "$AGENT"
}

request_stop() {
  STOP_REQUESTED=true
  printf '\n%bCtrl+C received; finishing the current loop before stopping.%b\n' "$YELLOW" "$RESET"
}

run_opencode_to_file() {
  prompt="$1"
  output_file="$2"
  run_status=0

  (trap '' INT; run_opencode "$prompt") > "$output_file" 2>&1 &
  run_pid=$!

  while true; do
    wait "$run_pid" || run_status=$?
    if [ "$run_status" -ge 128 ] && kill -0 "$run_pid" 2>/dev/null; then
      run_status=0
      continue
    fi
    break
  done

  return "$run_status"
}

recover_missing_handoff() {
  task="$1"
  attempt="$2"
  output_file="$3"
  recovery_output_file="${output_file}.recovery"
  recovery_prompt="$(build_handoff_recovery_prompt "$task" "$attempt")"
  recovery_status=0

  echo "Task requested continuation without /project/handoff.md. Starting recovery run."
  run_opencode_to_file "$recovery_prompt" "$recovery_output_file" || recovery_status=$?
  tr -d '\000' < "$recovery_output_file"
  rm -f "$recovery_output_file"

  if [ "$recovery_status" -ne 0 ]; then
    return "$recovery_status"
  fi
  if [ ! -s /project/handoff.md ]; then
    echo "Recovery run did not write a nonempty /project/handoff.md. Refusing unsafe retry."
    return 6
  fi

  echo "Recovery run wrote /project/handoff.md for the next iteration."
}

output_has_token() {
  output_file="$1"
  token="$2"
  tr -d '\000' < "$output_file" | grep -Fq "$token"
}

stop_if_requested() {
  if [ "$STOP_REQUESTED" = true ]; then
    loop_status 'stopping after current loop'
    exit 130
  fi
}

git_available() {
  command -v git >/dev/null 2>&1
}

inside_git_repo() {
  git_available && git -C "$REPO_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

has_worktree_changes() {
  [ -n "$(git -C "$REPO_PATH" status --porcelain)" ]
}

require_git_main() {
  if ! git_available || ! inside_git_repo; then
    printf 'Todo branch workflow requires a Git repository.\n' >&2
    exit 8
  fi
  if ! git -C "$REPO_PATH" show-ref --verify --quiet -- refs/heads/main; then
    printf 'Required local main branch does not exist.\n' >&2
    exit 8
  fi
}

current_branch() {
  git -C "$REPO_PATH" symbolic-ref --quiet --short HEAD
}

switch_to_task_branch() {
  branch="$1"
  if git -C "$REPO_PATH" show-ref --verify --quiet -- "refs/heads/$branch"; then
    if [ ! -t 0 ]; then
      printf 'Task branch %s already exists; interactive confirmation is unavailable. Stopping safely.\n' "$branch" >&2
      exit 9
    fi
    printf 'Task branch %s already exists. Resume it? [y/N] ' "$branch"
    read answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) printf 'Existing task branch left unchanged.\n'; exit 9 ;;
    esac
    if [ "$(current_branch 2>/dev/null || true)" != "$branch" ] && has_worktree_changes; then
      printf 'Cannot switch to existing task branch with worktree changes; commit or stash them manually.\n' >&2
      exit 4
    fi
    git -C "$REPO_PATH" switch -- "$branch"
  else
    if has_worktree_changes; then
      printf 'Cannot start a new task branch with worktree changes; commit or stash them manually.\n' >&2
      exit 4
    fi
    git -C "$REPO_PATH" switch -- main
    git -C "$REPO_PATH" switch -c "$branch"
  fi
}

require_task_branch() {
  branch="$1"
  if [ "$(current_branch 2>/dev/null || true)" != "$branch" ]; then
    printf 'Task must remain on branch %s; stopping safely.\n' "$branch" >&2
    exit 10
  fi
}

require_untracked_loop_files() {
  if git -C "$REPO_PATH" ls-files --error-unmatch -- "$TASK_REPO_FILE" >/dev/null 2>&1 ||
     git -C "$REPO_PATH" ls-files --error-unmatch -- "blocked-todos.md" >/dev/null 2>&1; then
    printf 'BLOCKED requires todo.md and blocked-todos.md to be untracked and ignored.\n' >&2
    exit 12
  fi
}

merge_task_branch() {
  branch="$1"
  git -C "$REPO_PATH" switch -- main
  git -C "$REPO_PATH" merge --ff-only -- "$branch"
}

return_to_main() {
  git -C "$REPO_PATH" switch -- main
}

clear_loop_handoff() {
  if [ -f /project/handoff.md ]; then
    rm -f /project/handoff.md
  fi
}

warn_dirty_worktree() {
  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if has_worktree_changes; then
    printf '\n%b%s%b\n' "$BOLD$YELLOW" '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!' "$RESET"
    printf '%bWARNING: loop finished with a dirty working tree.%b\n' "$BOLD$YELLOW" "$RESET"
    printf '%bReview, commit, stash, or clean these changes before continuing.%b\n' "$YELLOW" "$RESET"
    git -C "$REPO_PATH" status --short
    printf '%b%s%b\n\n' "$BOLD$YELLOW" '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!' "$RESET"
  fi
}

build_commit_prompt() {
  cat <<PROMPT
Inspect /code uncommitted changes. /code is the OpenCode container mount for $REPO_PATH. Include untracked files when they are required for the completed task.

Determine a concise, accurate commit message for the completed task work, then commit that work before the loop marks the todo item done.

Required process:
1. Inspect git status, tracked diffs, staged diffs, and recent commit style.
2. Load git-auto-commit because this prompt explicitly requests a commit.
3. Stage only files required for the completed task, including required untracked files. Do not stage unrelated files.
4. Commit with the chosen message.
5. Report the commit hash and message, or explain why no commit was created.
PROMPT
}

test_summary() {
  task_count="$(count_unchecked_tasks)"
  test_header "TEST MODE · summary"
  test_field "Git repo" "$REPO_PATH"
  test_field "Todo file" "$TASK_SOURCE"
  test_field "Todo tasks" "would run $task_count unchecked task(s), up to $MAX_LOOPS OpenCode run(s) each"
  test_field "DONE path" "prompt requires commit first; script would mark todo done and commit todo.md progress"
  test_field "BLOCKED path" "would move the task with Blocked by and Required to unblock metadata to blocked-todos.md, remove Handoff routing, commit partial work on the task branch, return to main without merging, and continue"
  test_field "Continue path" "prompt requests agent-authored /project/handoff.md; a missing handoff triggers a recovery run before retry; exhaustion follows the BLOCKED path"
  test_field "Branches" "each task runs on its Branch metadata branch; DONE fast-forwards local main and keeps the task branch"
  test_field "Final state" "would warn loudly if all todos finish with a dirty worktree"
  test_field "Blocked summary" "final output would report how many todos moved to blocked-todos.md"
  test_field "OpenCode runs" "none executed in test mode"
  printf '%b✓ TEST MODE: no OpenCode runs executed, no commits made, and no todo file edits made.%b\n' "$GREEN" "$RESET"
}

auto_commit_tracked_changes() {
  if ! git_available; then
    return 0
  fi

  if ! inside_git_repo; then
    return 0
  fi

  if ! has_worktree_changes; then
    return 0
  fi

  commit_prompt="$(build_commit_prompt)"

  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · worktree auto commit session"
    test_field "Git repo" "$REPO_PATH"
    test_field "Project" "$PROJECT"
    test_field "Agent" "code-implementor"
    test_block "Command" "$RUNNER \"$PROJECT\" run \"<prompt>\" --agent \"code-implementor\""
    test_block "Prompt" "$commit_prompt"
    printf '%b✓ Would automatically open this commit session without asking.%b\n' "$GREEN" "$RESET"
    return 0
  fi

  printf '%bWorktree changes detected; opening automatic commit session.%b\n' "$YELLOW" "$RESET"
  "$RUNNER" "$PROJECT" run "$commit_prompt" --agent "code-implementor"
  if has_worktree_changes; then
    printf '%bWorktree changes remain after automatic commit session.%b\n' "$YELLOW" "$RESET"
  fi
}

commit_todo_progress() {
  if ! git_available || ! inside_git_repo; then
    return 0
  fi

  if ! git -C "$REPO_PATH" diff --quiet -- "$TASK_REPO_FILE"; then
    git -C "$REPO_PATH" add -- "$TASK_REPO_FILE"
    git -C "$REPO_PATH" commit -m "Mark completed todo task"
  fi
}

commit_blocked_work() {
  git -C "$REPO_PATH" add -A
  if ! git -C "$REPO_PATH" diff --cached --quiet; then
    git -C "$REPO_PATH" commit -m "Save partial work for blocked task"
  fi
}

finish_blocked_task() {
  line="$1"
  task_context="$2"
  reason="$3"
  output_file="$4"
  attempt="$5"

  if [ -s /project/handoff.md ]; then
    handoff_context="$(cat /project/handoff.md)"
  else
    handoff_context="No handoff context provided."
  fi
  require_untracked_loop_files
  move_task_to_blocked "$line" "$task_context" "$handoff_context" "$reason"
  commit_blocked_work
  clear_loop_handoff
  if has_worktree_changes; then
    rm -f "$output_file"
    printf 'Unable to commit blocked task work; refusing to continue. Ensure todo.md and blocked-todos.md are ignored.\n' >&2
    exit 11
  fi
  return_to_main
  rm -f "$output_file"
  blocked_count=$((blocked_count + 1))
  echo "Task moved to blocked-todos.md. Continuing with the next todo."
  loop_status 'task moved to blocked' "$line" "$task_context" "$attempt"
  completed=true
}

run_todo_loop() {
  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · todo loop"
    test_field "Project" "$PROJECT"
    test_field "Agent" "$AGENT"
    test_field "Git repo" "$REPO_PATH"
    test_field "Todo file" "$TASK_SOURCE"
    test_field "Max loops/task" "$MAX_LOOPS"
    hr
    all_task_lines | while IFS= read -r line; do
    task="$(task_text "$line")"
    task_context="$(task_block "$line")"
    prompt="$(build_prompt "$task_context" "1")"
      branch="$(task_branch "$task_context")" || exit 8
      next_after_task="$(awk -v current="$line" '/^[[:space:]]*[-*] \[ \] / && NR > current { print NR; exit }' "$TASK_SOURCE")"
      printf '\n%bTask line %s%b\n' "$BOLD$BLUE" "$line" "$RESET"
      test_field "Task" "$task"
      test_field "Branch" "$branch"
      test_block "Command" "$RUNNER \"$PROJECT\" run \"<prompt>\" --agent \"$AGENT\""
      test_block "Prompt" "$prompt"
      test_block "DONE path" "Agent prompt requires validation and git-auto-commit before $DONE_TOKEN.
Script would clear /project/handoff.md, open a fallback commit session if worktree remains dirty, mark line $line complete, commit todo.md progress on $branch, switch to main, and run git merge --ff-only $branch."
      test_block "BLOCKED path" "Script would append the task plus Blocked by and Required to unblock metadata to blocked-todos.md, remove Handoff routing and the task from todo.md, commit partial work on $branch, clear /project/handoff.md, switch to main without merging, and continue."
      test_block "Continue path" "Agent prompt requires writing /project/handoff.md before omitting DONE/BLOCKED.
If absent, the sibling runner would inspect staged changes and write a recovery handoff. Script would run the same todo again until MAX_LOOPS=$MAX_LOOPS, then follow the BLOCKED path."
      if [ -n "$next_after_task" ]; then
        test_block "Between-todo path" "After fast-forwarding main, script would move to todo line $next_after_task."
      else
        test_block "Final-todo path" "No later unchecked todo exists. Script would not stash between todos; at final completion it would print a prominent dirty-worktree warning if needed."
      fi
      auto_commit_tracked_changes
      hr
    done
    test_summary
    return 0
  fi

  blocked_count=0
  loop_status 'starting'

  while true; do
    line="$(next_task_line || true)"
    if [ -z "$line" ]; then
      loop_status 'complete'
      echo "All todo tasks processed."
      echo "Todos moved to blocked: $blocked_count."
      warn_dirty_worktree
      return 0
    fi

      task="$(task_text "$line")"
      task_context="$(task_block "$line")"
      branch="$(task_branch "$task_context")" || exit 8
    echo "Next task on line $line: $task"

    require_git_main
    switch_to_task_branch "$branch"
    require_task_branch "$branch"

    completed=false
    for i in $(seq 1 "$MAX_LOOPS"); do
      prompt="$(build_prompt "$task_context" "$i")"
      loop_started_at="$(loop_timestamp)"
      loop_start_epoch="$(loop_epoch)"
      loop_status 'running task' "$line" "$task_context" "$i"
      test_field 'Loop started at' "$loop_started_at"
      echo "Starting task loop #$i at $loop_started_at..."
      output_file="${TMPDIR:-/tmp}/loop-output.$$.$i"
      run_status=0
      run_opencode_to_file "$prompt" "$output_file" || run_status=$?
      tr -d '\000' < "$output_file"
      print_loop_duration "$loop_start_epoch"

      if [ "$run_status" -ne 0 ]; then
        rm -f "$output_file"
        exit "$run_status"
      fi

      if output_has_token "$output_file" "$DONE_TOKEN"; then
        require_task_branch "$branch"
        clear_loop_handoff
        auto_commit_tracked_changes
        if has_worktree_changes; then
          rm -f "$output_file"
          printf 'DONE requires all task changes committed; worktree changes remain.\n' >&2
          exit 11
        fi
        mark_done "$line"
        echo "Marked task complete."
        commit_todo_progress
        if has_worktree_changes; then
          rm -f "$output_file"
          printf 'Unable to commit todo progress; refusing to merge.\n' >&2
          exit 11
        fi
        merge_task_branch "$branch"
        loop_status 'task completed' "$line" "$task_context" "$i"
        completed=true
        rm -f "$output_file"
        stop_if_requested
        break
      fi

      if output_has_token "$output_file" "$BLOCKED_TOKEN"; then
        require_task_branch "$branch"
        reason="$(blocked_reason "$output_file")"
        if [ -z "$reason" ]; then
          reason="No block reason provided."
        fi
        finish_blocked_task "$line" "$task_context" "$reason" "$output_file" "$i"
        stop_if_requested
        break
      fi

      if output_has_token "$output_file" "$CONTINUE_TOKEN"; then
        require_task_branch "$branch"
        if [ "$STOP_REQUESTED" = true ]; then
          rm -f "$output_file"
        fi
        stop_if_requested

        if [ ! -f /project/handoff.md ]; then
          rm -f "$output_file"
          recovery_status=0
          recover_missing_handoff "$task_context" "$i" "$output_file" || recovery_status=$?
          if [ "$recovery_status" -ne 0 ]; then
            exit "$recovery_status"
          fi
          stop_if_requested
        fi

        if [ "$i" -lt "$MAX_LOOPS" ]; then
          rm -f "$output_file"
          echo "Task continuing with validated handoff for next iteration."
          continue
        fi

        finish_blocked_task "$line" "$task_context" "Maximum loop attempts exhausted after $MAX_LOOPS runs." "$output_file" "$i"
        break
      fi

      rm -f "$output_file"
      echo "Task reply missing required token. Refusing unsafe retry."
      exit 5
    done

    if [ "$completed" != true ]; then
      clear_loop_handoff
      echo "Max loops reached for task. Leaving todo unchecked."
      exit 3
    fi

    stop_if_requested
  done
}

trap request_stop INT

if is_todo_file; then
  run_todo_loop
else
  if [ "$TEST_MODE" = true ]; then
    test_header "TEST MODE · todo loop"
    test_field "Git repo" "$REPO_PATH"
    test_field "Todo file" "$TASK_SOURCE"
    test_field "Todo status" "todo.md not found; no todo tasks would run"
    test_summary
    exit 0
  fi
  echo "No todo.md found at $TASK_SOURCE. Nothing to run."
fi
