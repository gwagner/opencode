#!/bin/bash

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=project-mounts.sh
. "$SCRIPT_DIR/project-mounts.sh"
resolve_project_mounts "${1:-}" || exit 1

ensure_container() {
  local name=$1
  local image=$2
  shift 2

  if docker container inspect "$name" >/dev/null 2>&1; then
    echo "Killing container $name"
    docker rm -f "$name" >/dev/null
  fi

  echo "Starting container $name"
  docker run -d --name "$name" "$@" "$image" >/dev/null
}

container_env_args=()
while IFS= read -r env_entry; do
  if [ -n "$env_entry" ]; then
    container_env_args+=(--env "$env_entry")
  fi
done <<< "${CONTAINER_ENV:-}"

container_network_args=()
if [ -n "${CONTAINER_NETWORK:-}" ]; then
  if ! docker network inspect "$CONTAINER_NETWORK" >/dev/null 2>&1; then
    docker network create "$CONTAINER_NETWORK" >/dev/null
  fi
  container_network_args+=(--network "$CONTAINER_NETWORK")
fi

if declare -F start_project_partners >/dev/null; then
  echo "Start Project Partners"
  start_project_partners
else

  echo "NO Start Project Partners"
fi

if [ ! -d "$DOCS_MOUNT" ]; then
  mkdir -p "$DOCS_MOUNT"
fi

if [ ! -d "$CODE_MOUNT" ]; then
  mkdir -p "$CODE_MOUNT"
fi


docker run -it --rm \
  "${container_env_args[@]}" \
  "${container_network_args[@]}" \
  -w /project/ \
  -v ~/.local/share/opencode/:/root/.local/share/opencode/ \
  -v ~/.config/opencode/:/root/.config/opencode/ \
  -v ~/.gitconfig:/root/.gitconfig \
  -v $(go env GOCACHE):/root/.cache/go-build \
  -v $(go env GOMODCACHE):/go/pkg/mod \
  --mount type=bind,source="$DOCS_MOUNT",target=/project/ \
  --mount type=bind,source="./",target=/project/.opencode/ \
  --mount type=bind,source="$CODE_MOUNT",target=/code/ \
  --mount type=bind,source="./AGENTS.md",target=/project/AGENTS.md \
  --mount type=bind,source="./log/",target=/log/ \
  "$CONTAINER" "${@:2}"

#  --entrypoint /bin/sh \
