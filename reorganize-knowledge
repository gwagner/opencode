#!/bin/bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ./reorganize-knowledge [--test[=N]|--dry-run[=N]] <project>

Safely evaluates Markdown files under requirements/ and specification/. Each
file is assessed in bounded line windows. Existing focused documents stay
unchanged. Approved replacements are built in staging, reviewed window by
window and candidate by candidate, promoted, compatibility-reviewed, then
automatically finalized. Originals remain available in the staging archive.

Environment:
  REORGANIZE_PREFERRED_SEGMENT_LINES  Preferred maximum semantic segment size (default: 80)
  REORGANIZE_CHUNK_LINES       Deprecated alias for the preferred segment size
  REORGANIZE_MAX_PASSES        Maximum adjustment passes per unit (default: 5)
  REORGANIZE_TEST_LIMIT        Dry-run semantic-unit sample size (default: 10)
USAGE
}

TEST_MODE=false
TEST_LIMIT_OVERRIDE=''
case "${1:-}" in
  --test|--dry-run) TEST_MODE=true; shift ;;
  --test=*|--dry-run=*) TEST_MODE=true; TEST_LIMIT_OVERRIDE=${1#*=}; shift ;;
esac
[ "$#" -eq 1 ] || { usage; exit 1; }

PROJECT=$1
SEGMENT_LINES=${REORGANIZE_PREFERRED_SEGMENT_LINES:-${REORGANIZE_CHUNK_LINES:-80}}
MAX_PASSES=${REORGANIZE_MAX_PASSES:-5}
TEST_LIMIT=${TEST_LIMIT_OVERRIDE:-${REORGANIZE_TEST_LIMIT:-10}}
[[ "$SEGMENT_LINES" =~ ^[1-9][0-9]*$ ]] || { printf 'Invalid preferred segment size\n' >&2; exit 1; }
[[ "$MAX_PASSES" =~ ^[1-9][0-9]*$ ]] || { printf 'Invalid REORGANIZE_MAX_PASSES\n' >&2; exit 1; }
[[ "$TEST_LIMIT" =~ ^[1-9][0-9]*$ ]] || { printf 'Invalid REORGANIZE_TEST_LIMIT\n' >&2; exit 1; }

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RUNNER="$SCRIPT_DIR/run"
MOUNT_RESOLVER="$SCRIPT_DIR/project-mounts.sh"
SEGMENTER="$SCRIPT_DIR/scripts/markdown-segments.py"
[ -r "$MOUNT_RESOLVER" ] || { printf 'Project mount resolver not found: %s\n' "$MOUNT_RESOLVER" >&2; exit 1; }
[ -r "$SEGMENTER" ] || { printf 'Markdown segmenter not found: %s\n' "$SEGMENTER" >&2; exit 1; }
# shellcheck source=/dev/null
. "$MOUNT_RESOLVER"
resolve_project_mounts "$PROJECT" || exit 1

DOCS_ROOT=${DOCS_MOUNT%/}
REQUIREMENTS_ROOT="$DOCS_ROOT/requirements"
SPECIFICATION_ROOT="$DOCS_ROOT/specification"
if [ ! -d "$REQUIREMENTS_ROOT" ] && [ ! -d "$SPECIFICATION_ROOT" ]; then
  printf 'No requirements or specification directory found under: %s\n' "$DOCS_ROOT" >&2
  exit 1
fi
[ "$TEST_MODE" = true ] || [ -x "$RUNNER" ] || { printf 'OpenCode runner not executable: %s\n' "$RUNNER" >&2; exit 1; }

temp_dir=$(mktemp -d)
manifest="$temp_dir/manifest"
output_file="$temp_dir/output"
trap 'rm -rf "$temp_dir"' EXIT INT TERM
roots=()
[ ! -d "$REQUIREMENTS_ROOT" ] || roots+=("$REQUIREMENTS_ROOT")
[ ! -d "$SPECIFICATION_ROOT" ] || roots+=("$SPECIFICATION_ROOT")
find "${roots[@]}" \
  -type d -name .reorganization -prune -o \
  -type f -name '*.md' ! -name index.md ! -name log.md -print0 |
  sort -z > "$manifest"

route_agent() {
  case "$1" in
    /project/requirements/*) printf '%s\n' prd-strategist ;;
    /project/specification/api/*|/project/specification/features/*|/project/specification/schema/*)
      printf '%s\n' code-spec-engineer ;;
    /project/specification/*) printf '%s\n' app-spec-architect ;;
    *) return 1 ;;
  esac
}

run_agent() {
  local prompt=$1 agent=$2
  : > "$output_file"
  if ! "$RUNNER" "$PROJECT" run "$prompt" --agent "$agent" > "$output_file" 2>&1; then
    tr -d '\000' < "$output_file"
    return 1
  fi
  tr -d '\000' < "$output_file"
}

decision() {
  local prefix=$1 value count
  count=$(tr -d '\000' < "$output_file" | grep -oE "<$prefix>[A-Z]+</$prefix>" | wc -l | tr -d ' ')
  [ "$count" -eq 1 ] || { printf 'Expected exactly one %s decision token.\n' "$prefix" >&2; return 1; }
  value=$(tr -d '\000' < "$output_file" | grep -oE "<$prefix>[A-Z]+</$prefix>" | sed -E "s#</?$prefix>##g")
  printf '%s\n' "$value"
}

assert_source_unchanged() {
  local source=$1 original=$2 expected=$3 actual
  actual=$(sha256sum "$source" | cut -d' ' -f1)
  if [ "$actual" != "$expected" ]; then
    cp "$original" "$source"
    printf 'Guardrail restored an original modified before finalization: %s\n' "$source" >&2
    return 1
  fi
}

manifest_contains() {
  python3 - "$manifest" "$1" <<'PY'
import sys

entries = open(sys.argv[1], "rb").read().split(b"\0")
raise SystemExit(0 if sys.argv[2].encode() in entries else 1)
PY
}

assert_bounded_staging_change() {
  local staging=$1 marker=$2 changed
  changed=$(find "$staging" -type f -name '*.md' -newer "$marker" | wc -l | tr -d ' ')
  if [ "$changed" -gt 1 ]; then
    printf 'Guardrail stopped a pass that changed %d candidates; maximum is one. Original retained.\n' "$changed" >&2
    return 1
  fi
}

assessment_prompt() {
  local path=$1 start=$2 end=$3 context=$4 metadata=$5 source_lines=$6 source_segments=$7
  cat <<PROMPT
Read-only reorganization assessment for one semantic Markdown segment in \`$path\`:
- Structural context: $context
- Source lines: $start-$end
- OKF metadata: ${metadata/none/not present}
- Source profile: $source_lines lines across $source_segments semantic segments; preferred maximum $SEGMENT_LINES lines.

Read only this segment, its heading ancestry when needed, and the indicated YAML frontmatter as organizational metadata. Do not treat frontmatter as source content, extract it into prose, split it into concepts, or propose reorganizing it. Use metadata only to understand identity, type, provenance, tags, ownership, and placement. Do not edit any file. The segmenter preserves headings and keeps fenced code, tables, lists, and other blank-line-delimited Markdown blocks intact; the preferred size is not permission to split those structures.

Load \`okf-reader\` and \`okf-reorganizer\`. Default to KEEP for a focused source that fits the preferred size. For an oversized source with multiple semantic segments, default to REPLACE when this segment can anchor a smaller coherent document without splitting an indivisible Markdown structure. A distinct concern, workflow, contract, requirement group, acceptance group, decision group, or independently useful section is a sufficient anchor; it need not have different metadata or ownership. Size plus a safe, meaningful segment boundary is sufficient retrieval evidence because the runner's purpose is to shrink oversized files. Choose KEEP for an oversized source only when this segment is inseparable from the source's one atomic concept and extracting it would reduce comprehension. Frontmatter content or formatting, possible shorter prose, or aesthetic hierarchy changes alone are not sufficient. Do not infer the content of unread segments.

Return exactly one token: \`<assessment>KEEP</assessment>\` or \`<assessment>REPLACE</assessment>\`, plus a concise evidence-based reason.
PROMPT
}

extraction_prompt() {
  local path=$1 start=$2 end=$3 context=$4 metadata=$5 staging=$6 pass=$7 source_lines=$8 source_segments=$9
  cat <<PROMPT
Extract losslessly from one semantic Markdown segment in \`$path\` into staged replacement concepts under \`$staging\` (pass $pass):
- Structural context: $context
- Source lines: $start-$end
- OKF metadata: ${metadata/none/not present}
- Source profile: $source_lines lines across $source_segments semantic segments; preferred maximum $SEGMENT_LINES lines.

Load \`okf-reader\`, \`okf-formatter\`, and \`okf-reorganizer\`. The original is immutable. This source was selected for splitting: the final staged replacement must contain at least two smaller, linked concept documents, not one renamed or equivalently broad copy. Inspect staged candidates to avoid duplication. Inventory every content assertion, decision, constraint, example, citation, link, ambiguity, contradiction, and open question in this segment. Group content by cohesive concern rather than mechanically by section type: keep each concern's requirements, acceptance criteria, decisions, assumptions, and evidence together when applicable. Read the indicated frontmatter separately as organizational metadata: use it to guide identity, type, provenance, tags, ownership, and placement, but never extract it into prose or reorganize it as content. Preserve applicable unknown metadata without semantically rewriting it. Create or materially adjust at most ONE candidate Markdown file this pass. Its path under the staging directory must equal its intended final bundle-relative path. Preserve specificity and provenance; never resolve conflicts or invent behavior. Do not edit indexes, logs, or final bundle files.

Return exactly one token: \`<extraction>MORE</extraction>\` when another candidate change is needed for this window, \`<extraction>DONE</extraction>\` when every inventory item is represented, or \`<extraction>BLOCKED</extraction>\` when lossless extraction is impossible.
PROMPT
}

coverage_prompt() {
  local path=$1 start=$2 end=$3 context=$4 metadata=$5 staging=$6 pass=$7
  cat <<PROMPT
Re-review compatibility and lossless coverage for one semantic Markdown segment in \`$path\` against candidates under \`$staging\` (pass $pass):
- Structural context: $context
- Source lines: $start-$end
- OKF metadata: ${metadata/none/not present}

The original is immutable.

Load \`okf-reader\`, \`okf-formatter\`, and \`okf-reorganizer\`. Check every content item, including contradictions, qualifiers, examples, citations, and links. Check frontmatter separately as metadata governing identity, provenance, classification, and placement; reject candidates that turn metadata into body content or treat metadata as an independent concept. Also check that candidate wording does not alter requirements or introduce design. Adjust at most ONE staged candidate if needed. Do not edit final files, indexes, or logs.

Return exactly one token: \`<coverage>PASS</coverage>\`, \`<coverage>ADJUSTED</coverage>\`, or \`<coverage>FAIL</coverage>\`.
PROMPT
}

candidate_prompt() {
  local path=$1 candidate=$2 staging=$3 pass=$4
  cat <<PROMPT
Review exactly one staged candidate, \`$candidate\`, for compatibility with its original \`$path\`, authoritative requirements, existing specifications, links, naming, and neighboring concepts (pass $pass). Candidate root: \`$staging\`.

Load \`okf-reader\`, \`okf-formatter\`, and \`okf-reorganizer\`. Requirements remain authoritative. Adjust only this candidate when required; do not reorganize anything else or edit final files.

Treat candidate frontmatter strictly as metadata for identity, provenance, classification, and retrieval. It must not be represented as body content or treated as an independently reorganizable concept.

Return exactly one token: \`<candidate>PASS</candidate>\`, \`<candidate>ADJUSTED</candidate>\`, or \`<candidate>FAIL</candidate>\`.
PROMPT
}

navigation_prompt() {
  local path=$1 staging=$2
  cat <<PROMPT
Prepare only the staged \`index.md\` and \`log.md\` updates needed to replace \`$path\` with reviewed candidates under \`$staging\`. Write navigation/history files beneath the staging root at their intended final bundle-relative paths. Preserve existing index and log content. Update links as if the original no longer exists. Do not edit final bundle files or the original. Return exactly \`<navigation>DONE</navigation>\` or \`<navigation>FAIL</navigation>\`.
PROMPT
}

final_prompt() {
  local path=$1 candidates=$2
  cat <<PROMPT
Perform a final READ-ONLY compatibility review of the promoted replacements for \`$path\`:
$candidates

Review links, indexes, history, requirement authority, duplicate/conflicting concepts, and behavior as if the original were removed. Do not edit anything. Return exactly \`<finalization>PASS</finalization>\` or \`<finalization>FAIL</finalization>\`.
PROMPT
}

rollback_promoted() {
  local bundle=$1 work=$2 rel
  if [ -f "$work/new-targets" ]; then
    while IFS= read -r rel; do rm -f "$bundle/$rel"; done < "$work/new-targets"
  fi
  if [ -f "$work/existing-targets" ]; then
    while IFS= read -r rel; do
      mkdir -p "$(dirname "$bundle/$rel")"
      cp "$work/backups/$rel" "$bundle/$rel"
    done < "$work/existing-targets"
  fi
}

processed=0
kept=0
finalized=0
sampled=0
sample_capped=false
run_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
if [ "$TEST_MODE" = true ]; then
  printf 'Knowledge reorganization dry-run sample (maximum %d semantic units)\n' "$TEST_LIMIT"
  printf '%s\n' 'No agents will run and no files will change.'
fi
while IFS= read -r -d '' source; do
  processed=$((processed + 1))
  relative=${source#"$DOCS_ROOT"/}
  container_path="/project/$relative"
  agent=$(route_agent "$container_path")
  lines=$(awk 'END { print NR }' "$source")
  [ "$lines" -gt 0 ] || lines=1
  segments_file="$temp_dir/segments-$processed"
  python3 "$SEGMENTER" "$source" "$SEGMENT_LINES" > "$segments_file"
  segment_values=$(tr -cd '\000' < "$segments_file" | wc -c | tr -d ' ')
  [ $((segment_values % 4)) -eq 0 ] || { printf 'Invalid semantic segment output for %s\n' "$source" >&2; exit 1; }
  segment_count=$((segment_values / 4))
  if [ "$segment_count" -eq 0 ]; then
    if [ "$TEST_MODE" = false ]; then
      kept=$((kept + 1))
      printf '[%d] Keep unchanged: %s contains metadata but no reorganizable body content.\n' "$processed" "$container_path"
    fi
    continue
  fi
  if [ "$TEST_MODE" = false ]; then
    printf '[%d] Assess %s (%s, %d lines, %d semantic segments)\n' "$processed" "$container_path" "$agent" "$lines" "$segment_count"
  fi

  replace=false
  while IFS= read -r -d '' start && IFS= read -r -d '' end && IFS= read -r -d '' context && IFS= read -r -d '' metadata; do
    if [ "$TEST_MODE" = true ]; then
      if [ "$sampled" -ge "$TEST_LIMIT" ]; then
        sample_capped=true
        break
      fi
      sampled=$((sampled + 1))
      printf '\n[%d] %s\n' "$sampled" "$container_path"
      printf '    Agent:   %s\n' "$agent"
      printf '    Lines:   %s-%s\n' "$start" "$end"
      printf '    Context: %s\n' "$context"
      printf '    Metadata: %s\n' "${metadata/none/not present}"
      continue
    fi
    prompt=$(assessment_prompt "$container_path" "$start" "$end" "$context" "$metadata" "$lines" "$segment_count")
    run_agent "$prompt" "$agent"
    result=$(decision assessment)
    case "$result" in KEEP) ;; REPLACE) replace=true ;; *) printf 'Invalid assessment: %s\n' "$result" >&2; exit 1 ;; esac
  done < "$segments_file"
  if [ "$TEST_MODE" = true ]; then
    if [ "$sampled" -ge "$TEST_LIMIT" ]; then
      sample_capped=true
      break
    fi
    continue
  fi
  if [ "$replace" = false ]; then
    kept=$((kept + 1)); printf 'Keep unchanged: %s\n' "$container_path"; continue
  fi

  bundle_name=${relative%%/*}
  bundle="$DOCS_ROOT/$bundle_name"
  bundle_container="/project/$bundle_name"
  source_rel=${relative#*/}
  source_hash=$(sha256sum "$source" | cut -d' ' -f1)
  id=$(printf '%s' "$relative:$source_hash" | sha256sum | cut -c1-16)
  work="$bundle/.reorganization/$run_id/$id"
  staging="$work/candidates"
  staging_container="$bundle_container/.reorganization/$run_id/$id/candidates"
  mkdir -p "$staging"
  cp "$source" "$work/original.md"

  while IFS= read -r -d '' start && IFS= read -r -d '' end && IFS= read -r -d '' context && IFS= read -r -d '' metadata; do
    for ((pass=1; pass<=MAX_PASSES; pass++)); do
      marker="$work/change-marker"; touch "$marker"
      run_agent "$(extraction_prompt "$container_path" "$start" "$end" "$context" "$metadata" "$staging_container" "$pass" "$lines" "$segment_count")" "$agent"
      assert_source_unchanged "$source" "$work/original.md" "$source_hash"
      assert_bounded_staging_change "$staging" "$marker"
      result=$(decision extraction)
      case "$result" in DONE) break ;; MORE) ;; BLOCKED) printf 'Extraction blocked; original retained: %s\n' "$container_path" >&2; exit 1 ;; *) exit 1 ;; esac
    done
    [ "$result" = DONE ] || { printf 'Extraction pass limit reached; original retained.\n' >&2; exit 1; }
  done < "$segments_file"
  candidate_count=$(find "$staging" -type f -name '*.md' | wc -l | tr -d ' ')
  if [ "$candidate_count" -lt 2 ]; then
    printf 'Split produced %d replacement candidate(s); at least two are required. Original retained.\n' "$candidate_count" >&2
    exit 1
  fi

  while IFS= read -r -d '' start && IFS= read -r -d '' end && IFS= read -r -d '' context && IFS= read -r -d '' metadata; do
    for ((pass=1; pass<=MAX_PASSES; pass++)); do
      marker="$work/change-marker"; touch "$marker"
      run_agent "$(coverage_prompt "$container_path" "$start" "$end" "$context" "$metadata" "$staging_container" "$pass")" "$agent"
      assert_source_unchanged "$source" "$work/original.md" "$source_hash"
      assert_bounded_staging_change "$staging" "$marker"
      result=$(decision coverage)
      case "$result" in PASS) break ;; ADJUSTED) ;; FAIL) printf 'Coverage review failed; original retained.\n' >&2; exit 1 ;; *) exit 1 ;; esac
    done
    [ "$result" = PASS ] || { printf 'Coverage review pass limit reached; original retained.\n' >&2; exit 1; }
  done < "$segments_file"

  while IFS= read -r -d '' candidate; do
    candidate_container="$staging_container/${candidate#"$staging"/}"
    for ((pass=1; pass<=MAX_PASSES; pass++)); do
      marker="$work/change-marker"; touch "$marker"
      run_agent "$(candidate_prompt "$container_path" "$candidate_container" "$staging_container" "$pass")" "$agent"
      assert_source_unchanged "$source" "$work/original.md" "$source_hash"
      assert_bounded_staging_change "$staging" "$marker"
      result=$(decision candidate)
      case "$result" in PASS) break ;; ADJUSTED) ;; FAIL) printf 'Candidate review failed; original retained.\n' >&2; exit 1 ;; *) exit 1 ;; esac
    done
    [ "$result" = PASS ] || { printf 'Candidate review pass limit reached; original retained.\n' >&2; exit 1; }
  done < <(find "$staging" -type f -name '*.md' -print0 | sort -z)

  run_agent "$(navigation_prompt "$container_path" "$staging_container")" "$agent"
  assert_source_unchanged "$source" "$work/original.md" "$source_hash"
  [ "$(decision navigation)" = DONE ] || { printf 'Navigation preparation failed; original retained.\n' >&2; exit 1; }

  : > "$work/existing-targets"; : > "$work/new-targets"
  candidate_list=''
  while IFS= read -r -d '' candidate; do
    rel=${candidate#"$staging"/}
    target="$bundle/$rel"
    if [ "$target" != "$source" ] && manifest_contains "$target"; then
      printf 'Candidate would overwrite another queued source; original retained: %s\n' "$target" >&2
      exit 1
    fi
    mkdir -p "$(dirname "$target")"
    if [ -f "$target" ]; then
      printf '%s\n' "$rel" >> "$work/existing-targets"
      mkdir -p "$(dirname "$work/backups/$rel")"; cp "$target" "$work/backups/$rel"
    else
      printf '%s\n' "$rel" >> "$work/new-targets"
    fi
    cp "$candidate" "$target"
    candidate_list+="- \`$bundle_container/$rel\`"$'\n'
  done < <(find "$staging" -type f -name '*.md' -print0 | sort -z)

  run_agent "$(final_prompt "$container_path" "$candidate_list")" "$agent"
  result=$(decision finalization)
  if [ "$result" != PASS ]; then
    rollback_promoted "$bundle" "$work"
    printf 'Final compatibility review failed; promoted files rolled back and original retained.\n' >&2
    exit 1
  fi

  if ! grep -Fxq "$source_rel" "$work/existing-targets" && ! grep -Fxq "$source_rel" "$work/new-targets"; then
    rm "$source"
  fi
  printf '%s\n' "finalized_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$work/complete"
  finalized=$((finalized + 1))
  printf 'Finalized reviewed replacement: %s (original archived at %s)\n' "$container_path" "$work/original.md"
done < "$manifest"

if [ "$TEST_MODE" = true ]; then
  printf '\nDry run sampled %d semantic unit(s) from %d source file(s).\n' "$sampled" "$processed"
  if [ "$sample_capped" = true ]; then
    printf 'Sample limit reached; remaining sources were not scanned. Set REORGANIZE_TEST_LIMIT to adjust.\n'
  else
    printf 'All discovered semantic units fit within the sample limit.\n'
  fi
else
  printf 'Completed: %d assessed, %d kept unchanged, %d finalized.\n' "$processed" "$kept" "$finalized"
fi
